    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@types/jest": "^29.5.5",
    "@types/supertest": "^2.0.12",
    "babel-jest": "^30.4.1",
    "cross-env": "^10.1.0",
    "jest": "^25.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"

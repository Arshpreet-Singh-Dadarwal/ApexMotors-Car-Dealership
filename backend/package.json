{
  "name": "dealership-backend",
  "version": "1.0.0",
  "description": "Node.js backend for dealership inventory with MongoDB",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
